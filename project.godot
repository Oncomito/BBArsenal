config_version=5

[application]

config/name="BBArsenal"
config/version="0.0.1"
run/main_scene="uid://cvbebrbh8kq0t"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.047058824, 0.05882353, 0.105882354, 1)
boot_splash/show_image=false
boot_splash/image="uid://xnnc42dqews1"
config/icon="uid://cwkgbrssautdt"

[autoload]

GameManager="*uid://b1ob117q78v87"
AudioManager="*uid://1qhywl3ams5k"
Gamemanager="*uid://b1ob117q78v87"
Audiomanager="*uid://1qhywl3ams5k"
